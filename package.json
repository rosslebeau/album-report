    "nanoid": "^5.0.0",
    "pg": "^8.13.0",
    "pino": "^9.0.0",
    "pino-roll": "^3.0.0",
    "svelte": "^5.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/svelte": "^5.0.0",
    "@types/pg": "^8.11.0",
    "dotenv": "^17.3.1",
    "jsdom": "^25.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
